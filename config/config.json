{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "agility-101-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/agility101/Agility101WebPart.js",
          "manifest": "./src/webparts/agility101/Agility101WebPart.manifest.json"
        }
      ]
    },
    "home-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/home/HomeWebPart.js",
          "manifest": "./src/webparts/home/HomeWebPart.manifest.json"
        }
      ]
    },
    "page-chrome-application-customizer": {
      "components": [
        {
          "entrypoint": "./lib/extensions/pageChrome/PageChromeApplicationCustomizer.js",
          "manifest": "./src/extensions/pageChrome/PageChromeApplicationCustomizer.manifest.json"
        }
      ]
    },
    "about-tg-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/aboutTg/AboutTgWebPart.js",
          "manifest": "./src/webparts/aboutTg/AboutTgWebPart.manifest.json"
        }
      ]
    },
    "news-events-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/newsEvents/NewsEventsWebPart.js",
          "manifest": "./src/webparts/newsEvents/NewsEventsWebPart.manifest.json"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "Agility101WebPartStrings": "lib/webparts/agility101/loc/{locale}.js",
    "HomeWebPartStrings": "lib/webparts/home/loc/{locale}.js",
    "AboutTgWebPartStrings": "lib/webparts/aboutTg/loc/{locale}.js",
    "NewsEventsWebPartStrings": "lib/webparts/newsEvents/loc/{locale}.js",
    "PageChromeApplicationCustomizerStrings": "lib/extensions/pageChrome/loc/{locale}.js"
  }
}
